# Copy to .env and fill in.

# --- Claude (Bull vs Bear) ---
ANTHROPIC_API_KEY=
# Any Claude model ID your key can use.
CLAUDE_MODEL=claude-sonnet-5-5

# --- SEC EDGAR ---
# The SEC requires a User-Agent that identifies you: "Name email@domain".
# Requests without one get blocked.
SEC_USER_AGENT=

# --- Database ---
# Leave unset for a local SQLite file (data/finsight.db). For Postgres from docker-compose:
# DATABASE_URL=postgresql+psycopg://finsight:finsight@localhost:5432/finsight

# --- Neo4j (docker-compose defaults) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=finsight-neo4j

# --- Insider radar alerts (optional) ---
# Any URL that accepts a JSON POST with a "text" field (Slack incoming webhook works).
ALERT_WEBHOOK_URL=
